{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://borisbostandzhiev.dev/schemas/project.meta.schema.json",
  "title": "Project metadata",
  "description": "Portfolio-facing metadata for a single web project. Generated by scripts/generate-project-meta.mjs from scripts/project-meta.config.mjs plus facts derived from the repository.",
  "type": "object",
  "required": ["schemaVersion", "identity", "runtime", "metrics"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatedBy": { "type": "string" },
    "identity": {
      "type": "object",
      "required": ["slug", "repoName", "title"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "repoName": { "type": "string" },
        "packageName": { "type": "string" },
        "version": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
        "classification": {
          "type": "string",
          "enum": ["web-app", "web-library", "web-site", "duplicate", "archived", "template", "tooling", "hosted-only"]
        },
        "showcaseTier": { "type": "string", "enum": ["showcase", "more", "excluded"] },
        "showcaseOrder": { "type": "integer", "minimum": 1 },
        "duplicateOf": { "type": "string" },
        "excludedReason": { "type": "string" }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "deploymentUrl": { "type": "string" },
        "localUrl": { "type": "string" },
        "homepage": { "type": "string" },
        "repository": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "packageManager": { "type": "string", "enum": ["npm", "yarn", "pnpm", "bun"] },
        "nodeEngine": { "type": "string" },
        "buildCommand": { "type": "string" },
        "buildOutput": { "type": "string" },
        "buildCwd": { "type": "string" },
        "runCommand": { "type": "string" },
        "runCwd": { "type": "string" },
        "devPort": { "type": "integer" },
        "fallbackCommand": { "type": "string" },
        "fallbackCwd": { "type": "string" },
        "fallbackEnv": { "type": "object" },
        "serveBasePath": { "type": "string" },
        "scripts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capture": {
      "type": "object",
      "description": "Recipe the portfolio screenshot pipeline uses to photograph this project.",
      "properties": {
        "route": { "type": "string" },
        "stableRoute": { "type": "string" },
        "latestRoute": { "type": "string" },
        "readySelector": { "type": "string" },
        "readyState": { "type": "string" },
        "waitAfterReadyMs": { "type": "integer" },
        "hideSelectors": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "array", "items": { "type": "object" } }
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "source": { "type": "string", "enum": ["portfolio-capture", "portfolio-capture-missing", "repo-local", "none"] },
        "directory": { "type": "string" },
        "primary": { "type": "string" },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["profile", "file", "path"],
            "properties": {
              "profile": { "type": "string" },
              "file": { "type": "string" },
              "path": { "type": "string" },
              "bytes": { "type": "integer" },
              "width": { "type": "integer" },
              "height": { "type": "integer" },
              "capturedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "properties": {
        "framework": { "type": "string" },
        "language": { "type": "string" },
        "runtimeTargets": { "type": "array", "items": { "type": "string" } },
        "libraries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
          }
        },
        "testing": { "type": "array", "items": { "type": "string" } },
        "appDirectory": { "type": "string" },
        "dependencyCount": { "type": "integer" },
        "devDependencyCount": { "type": "integer" },
        "workspaces": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["sourceFiles", "testFiles"],
      "properties": {
        "sourceFiles": { "type": "integer" },
        "testFiles": { "type": "integer" },
        "sourceLines": { "type": "integer" },
        "largestDirectories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "directory": { "type": "string" }, "files": { "type": "integer" } }
          }
        },
        "hasReadme": { "type": "boolean" },
        "hasTests": { "type": "boolean" },
        "hasCi": { "type": "boolean" },
        "hasDocs": { "type": "boolean" }
      }
    },
    "scores": {
      "type": "object",
      "properties": {
        "priorityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "demoabilityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "depthScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "polishScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "uniquenessScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maintenanceScore": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "analysisNotes": { "type": "string" },
    "git": {
      "type": "object",
      "properties": {
        "branch": { "type": "string" },
        "head": { "type": "string" },
        "lastCommitDate": { "type": "string" },
        "lastCommitSubject": { "type": "string" },
        "commitCount": { "type": "integer" },
        "remote": { "type": "string" }
      }
    },
    "readme": {
      "type": "object",
      "properties": { "file": { "type": "string" }, "heading": { "type": "string" } }
    }
  }
}
